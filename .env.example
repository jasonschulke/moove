# Supabase (optional). Without these, auth and cloud sync are disabled and the
# app runs purely local-first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The model the AI coach talks to. Defaults to the value in src/config.ts.
VITE_CLAUDE_MODEL=

# Set to "true" to let the coach work without the user supplying their own
# Anthropic key. Requires ANTHROPIC_API_KEY below to be set on the deploy.
VITE_CLAUDE_PROXY=false

# Server-side only. Read by netlify/functions/claude.ts and never exposed to
# the browser. Do NOT prefix this with VITE_, which would bundle it.
ANTHROPIC_API_KEY=
